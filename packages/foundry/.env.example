# Template for foundry environment variables. Copy to .env (done automatically on install).

# Hedera JSON-RPC endpoint (testnet default; use mainnet.hashio.io for mainnet).
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Default keystore account for localhost; use "scaffold-hbar-custom" for a generated or imported account.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default

# Only for `yarn foundry:demo`: a funded Hedera testnet key (a throwaway account, never a real one).
DEPLOYER_PRIVATE_KEY=

# Optional deploy-time settings (see README, Configuration).
# CHARITY_ADDRESS=0x...
# SOURCE_HBAR_RESERVE=
